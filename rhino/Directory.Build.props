<Project>
  <PropertyGroup>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <Product>Family Studio</Product>
    <Company>Family Studio</Company>
    <Authors>Chicago Innovate Hackathon 2026 team</Authors>
    <Copyright>Copyright (c) 2026 Ty Holbrook</Copyright>

    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>

    <!--
      The RhinoCommon reference is also the MINIMUM Rhino version the plugin claims to support.
      8.0 matches McNeel's own template, so the plugin loads on every Rhino 8 service release.
    -->
    <RhinoCommonVersion Condition="'$(RhinoCommonVersion)' == ''">8.0.23304.9001</RhinoCommonVersion>
  </PropertyGroup>
</Project>
