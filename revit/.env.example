# Family Studio for Revit: local settings
#
# Copy this file to revit/.env and fill in what you need. Every value is optional.
# The build copies .env next to the add-in, and Family Studio reads it each time its window
# opens. You can also keep one at %APPDATA%\FamilyStudio\.env. Never commit .env.

# =============================================================================================
# OpenAI: ChatGPT sign-in through Codex (this is what powers Family Studio)
# =============================================================================================
# There is no key to paste. Family Studio runs OpenAI's Codex app on this computer, and you click
# "Sign in with ChatGPT" in the plugin (or "Use a code instead"). Codex stores the sign-in in the
# folder below and keeps it refreshed. By default Family Studio uses its own folder, separate from
# any personal Codex setup:
#     %LOCALAPPDATA%\FamilyStudio\codex-home
#
# To reuse the sign-in you already have in the Codex app or CLI, point this at its folder:
#     OPENAI_CODEX_HOME=%USERPROFILE%\.codex
OPENAI_CODEX_HOME=

# Full path to codex.exe, only if Family Studio cannot find it by itself. It looks on PATH, in the
# Codex app's install folder, and in the npm package (npm install -g @openai/codex).
OPENAI_CODEX_PATH=

# Model and reasoning effort. Leave blank for your ChatGPT plan's default model at "high" effort.
# The plugin's settings menu lists every model your plan offers.
OPENAI_CODEX_MODEL=
OPENAI_CODEX_REASONING_EFFORT=

# =============================================================================================
# OpenRouter
# =============================================================================================
# Reserved for upcoming features. Family Studio does not send anything to OpenRouter yet;
# the settings menu can check that the key works.
OPENROUTER_API_KEY=

# =============================================================================================
# Optional
# =============================================================================================
# Where session folders (references, families, previews and logs) are written.
# Default: %LOCALAPPDATA%\FamilyStudio\sessions
FAMILY_STUDIO_OUTPUT_DIR=

# A furniture family template (.rft), if Revit's default templates are not installed.
FAMILY_STUDIO_FURNITURE_TEMPLATE=
