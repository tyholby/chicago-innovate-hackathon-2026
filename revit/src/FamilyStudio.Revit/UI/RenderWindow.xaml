<Window x:Class="FamilyStudio.Revit.UI.RenderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:FamilyStudio.Revit.UI"
        Title="View2Render" Width="1180" Height="780" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        Background="{DynamicResource FS.Bg}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is the theme. ThemeManager swaps it for Night.xaml when Revit is dark. -->
                <ResourceDictionary Source="/FamilyStudio.Revit;component/UI/Theme/Paper.xaml"/>
                <ResourceDictionary Source="/FamilyStudio.Revit;component/UI/Theme/Studio.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ui:VisibleWhen x:Key="Visible"/>
            <ui:VisibleWhen x:Key="Collapsed" Invert="True"/>

            <!-- A title block cell: tracked label over a value. -->
            <Style x:Key="Cell" TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource FS.Rule}"/>
                <Setter Property="BorderThickness" Value="1,0,0,0"/>
                <Setter Property="Padding" Value="14,9,14,8"/>
            </Style>
            <Style x:Key="Section" TargetType="ui:Caps">
                <Setter Property="FontFamily" Value="{StaticResource FS.Font.Label}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource FS.Ink3}"/>
                <Setter Property="Margin" Value="0,22,0,6"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding PrimaryCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>

    <Border x:Name="Root" BorderBrush="{DynamicResource FS.RuleStrong}" BorderThickness="1" Background="{DynamicResource FS.Bg}">
        <Grid TextElement.FontFamily="{StaticResource FS.Font.Sans}" TextElement.Foreground="{DynamicResource FS.Ink}">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============================== HEADER: mark and account ============================== -->
            <Grid Background="{DynamicResource FS.Surface}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Rectangle Grid.ColumnSpan="4" Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource FS.Rule}"/>

                <StackPanel Orientation="Horizontal" Margin="20,0,36,0" VerticalAlignment="Center">
                    <!-- The Family Studio box inside a viewport frame. -->
                    <Canvas Width="24" Height="22" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Rectangle Canvas.Left="0.5" Canvas.Top="1.5" Width="23" Height="19" Fill="{DynamicResource FS.Surface}" Stroke="{DynamicResource FS.Ink}" StrokeThickness="1.2"/>
                        <Path Data="M12,5 L17.5,7.75 L12,10.5 L6.5,7.75 Z" Fill="{DynamicResource FS.Surface}" Stroke="{DynamicResource FS.Ink}" StrokeThickness="1" StrokeLineJoin="Round"/>
                        <Path Data="M6.5,7.75 L12,10.5 L12,16.5 L6.5,13.75 Z" Fill="{DynamicResource FS.Accent}" Stroke="{DynamicResource FS.Ink}" StrokeThickness="1" StrokeLineJoin="Round"/>
                        <Path Data="M12,10.5 L17.5,7.75 L17.5,13.75 L12,16.5 Z" Fill="{DynamicResource FS.Rule}" Stroke="{DynamicResource FS.Ink}" StrokeThickness="1" StrokeLineJoin="Round"/>
                    </Canvas>
                    <ui:Caps Label="View2Render" FontSize="13" Foreground="{DynamicResource FS.Ink}" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Column="2" BorderBrush="{DynamicResource FS.Rule}" BorderThickness="1" CornerRadius="2" Padding="10,5" VerticalAlignment="Center" Margin="0,0,6,0"
                        ToolTip="Renders use your ChatGPT sign-in, the same one as Family Studio.">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource FS.Success}" VerticalAlignment="Center" Margin="0,0,8,0"
                                 Visibility="{Binding IsSignedIn, Converter={StaticResource Visible}}"/>
                        <TextBlock Text="{Binding AccountLabel}" FontSize="12" Foreground="{DynamicResource FS.Ink2}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Style="{StaticResource FS.Button.Glyph}" Width="46" Height="48" Click="OnMinimize" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize">
                        <Path Data="M0,0.5 L10,0.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                    </Button>
                    <Button Style="{StaticResource FS.Button.Glyph}" Width="46" Height="48" Click="OnMaximize" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximize">
                        <Rectangle Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                    </Button>
                    <Button Style="{StaticResource FS.Button.Close}" Click="OnClose" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============================== WORK: drawing area and schedule ============================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="372"/>
                </Grid.ColumnDefinitions>

                <!-- ~~~~~ Drawing area: the view, then its render ~~~~~ -->
                <Grid Margin="28,20,28,20">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="10,0,10,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource FS.Button.Quiet}" Content="Open session folder" Command="{Binding OpenFolderCommand}" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource FS.Segments}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource FS.Segment}" Content="View" Command="{Binding ShowViewCommand}" IsChecked="{Binding ShowingView, Mode=OneWay}"/>
                                <RadioButton Style="{StaticResource FS.Segment}" Content="Render" Command="{Binding ShowRenderCommand}" IsChecked="{Binding ShowingRender, Mode=OneWay}"/>
                            </StackPanel>
                        </Border>
                    </DockPanel>

                    <ContentControl Grid.Row="1" Style="{StaticResource FS.Plate}" ui:Studio.Checked="{Binding HasFigure}">
                        <Grid>
                            <!-- VIEW: what Revit showed when it was captured -->
                            <Grid Visibility="{Binding ShowingView, Converter={StaticResource Visible}}">
                                <Border Background="{DynamicResource FS.Raised}" Visibility="{Binding HasCapture, Converter={StaticResource Visible}}">
                                    <Image Source="{Binding CaptureImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400"
                                            Visibility="{Binding HasCapture, Converter={StaticResource Collapsed}}">
                                    <Canvas Width="56" Height="44" HorizontalAlignment="Center">
                                        <Path Data="M1,1 L55,1 L55,43 L1,43 Z M20,16 L28,12 L36,16 L28,20 Z M20,16 L28,20 L28,30 L20,26 Z M28,20 L36,16 L36,26 L28,30"
                                              Stroke="{DynamicResource FS.Construction}" StrokeThickness="1.3" StrokeLineJoin="Round"/>
                                    </Canvas>
                                    <TextBlock Style="{StaticResource FS.Text.Heading}" Text="No view captured yet" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                                    <TextBlock Style="{StaticResource FS.Text.Small}" Text="{Binding CaptureProblem}" TextAlignment="Center" Margin="0,8,0,0"/>
                                    <Button Style="{StaticResource FS.Button.Secondary}" Content="Capture the active view" Command="{Binding CaptureCommand}" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- RENDER: the result, or the view developing while it renders -->
                            <Grid Visibility="{Binding ShowingRender, Converter={StaticResource Visible}}">
                                <Border Background="{DynamicResource FS.Raised}" Visibility="{Binding ShowRenderImage, Converter={StaticResource Visible}}">
                                    <Image Source="{Binding RenderImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <Grid Visibility="{Binding IsBusy, Converter={StaticResource Visible}}">
                                    <Image Source="{Binding CaptureImage}" Stretch="Uniform" Opacity="0.28" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <Border Background="{DynamicResource FS.Surface}" BorderBrush="{DynamicResource FS.Rule}" BorderThickness="1" CornerRadius="2"
                                            Padding="28,22" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource FS.Text.Mono}" FontSize="13" Foreground="{DynamicResource FS.Ink2}"
                                                           Text="{Binding ProgressLabel}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                <TextBlock Style="{StaticResource FS.Text.Heading}" Text="{Binding ProgressText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            </DockPanel>
                                            <ProgressBar Style="{StaticResource FS.Progress}" Value="{Binding ProgressPercent, Mode=OneWay}" Margin="0,14,0,0"/>
                                            <TextBlock Style="{StaticResource FS.Text.Small}" Margin="0,12,0,0">
                                                ChatGPT image generation turns the captured view into a photorealistic render. It usually takes one to two minutes.
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380"
                                            Visibility="{Binding ShowRenderEmpty, Converter={StaticResource Visible}}">
                                    <TextBlock Style="{StaticResource FS.Text.Heading}" Text="No render yet" HorizontalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource FS.Text.Small}" TextAlignment="Center" Margin="0,8,0,0">
                                        Choose Render view below. The render appears here, ready to download.
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </ContentControl>

                    <DockPanel Grid.Row="2" Margin="10,10,10,0" MinHeight="32">
                        <Button DockPanel.Dock="Right" Style="{StaticResource FS.Button.Secondary}" Command="{Binding DownloadCommand}"
                                Visibility="{Binding CanDownload, Converter={StaticResource Visible}}" ToolTip="Save the render to this computer">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M5,0 L5,8 M1.5,4.5 L5,8 L8.5,4.5 M0,11.5 L10,11.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.3" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Download"/>
                            </StackPanel>
                        </Button>
                        <ui:Caps Label="{Binding FigureCaption}" FontFamily="{StaticResource FS.Font.Mono}" FontWeight="Normal" FontSize="10" VerticalAlignment="Center"/>
                    </DockPanel>
                </Grid>

                <Rectangle Grid.Column="1" Fill="{DynamicResource FS.Rule}"/>

                <!-- ~~~~~ Schedule column: view, prompt, references ~~~~~ -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Background="{DynamicResource FS.Surface}">
                    <StackPanel Margin="28,6,28,28">
                        <ui:Caps Style="{StaticResource Section}" Label="View"/>
                        <TextBlock Style="{StaticResource FS.Text.Title}" Text="{Binding ViewTitle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        <TextBlock Style="{StaticResource FS.Text.Small}" Text="{Binding ViewDetail}" Margin="0,4,0,0" Visibility="{Binding ViewDetail, Converter={StaticResource Visible}}"/>
                        <Button Style="{StaticResource FS.Button.Quiet}" Content="Capture the active view again" Command="{Binding CaptureCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                        <TextBlock Style="{StaticResource FS.Text.Small}" Margin="0,6,0,0">
                            Frame the view in Revit first. A shaded or realistic 3D view renders most faithfully.
                        </TextBlock>

                        <ui:Caps Style="{StaticResource Section}" Label="Prompt"/>
                        <TextBox Style="{StaticResource FS.Notes}" Text="{Binding UserPrompt, UpdateSourceTrigger=PropertyChanged}" MinHeight="92" IsEnabled="{Binding CanEdit}"
                                 Tag="Optional. For example: golden hour light, oak floors, a snowy garden outside."/>
                        <TextBlock Style="{StaticResource FS.Text.Small}" Margin="0,6,0,0">Added to the default render prompt as additional context.</TextBlock>

                        <DockPanel Margin="0,22,0,6">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource FS.Text.Mono}" FontSize="11" Foreground="{DynamicResource FS.Ink3}"
                                       Text="{Binding ReferenceCount}" VerticalAlignment="Center"/>
                            <ui:Caps Style="{StaticResource Section}" Label="Reference images" Margin="0"/>
                        </DockPanel>
                        <Grid AllowDrop="True" DragOver="OnReferenceDragOver" Drop="OnReferenceDrop" Background="Transparent" IsEnabled="{Binding CanEdit}">
                            <Rectangle Stroke="{DynamicResource FS.Construction}" StrokeThickness="1" StrokeDashArray="6 4" SnapsToDevicePixels="True"/>
                            <StackPanel Margin="12,12,4,12">
                                <ItemsControl ItemsSource="{Binding References}" Visibility="{Binding HasReferences, Converter={StaticResource Visible}}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="68" Height="68" Margin="0,0,8,8" ToolTip="{Binding Caption}">
                                                <Border Background="{DynamicResource FS.Raised}" BorderBrush="{DynamicResource FS.Rule}" BorderThickness="1" ClipToBounds="True">
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border>
                                                <Button Style="{StaticResource FS.Button.Glyph}" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0"
                                                        Background="{DynamicResource FS.Surface}" ToolTip="Remove"
                                                        Command="{Binding DataContext.RemoveReferenceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                    <Path Data="M0,0 L7,7 M7,0 L0,7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource FS.Text}" Text="Drop images here" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                <Button Style="{StaticResource FS.Button.Quiet}" Content="or choose files" Command="{Binding AddReferencesCommand}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource FS.Text.Small}" Margin="0,6,0,0">
                            Optional, up to eight. ChatGPT takes materials, lighting, mood and style from them, never the view's geometry or camera.
                        </TextBlock>

                        <ui:Caps Style="{StaticResource Section}" Label="Prompt sent to ChatGPT"/>
                        <TextBlock Style="{StaticResource FS.Text.Small}" Text="{Binding PromptPreview}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ============================== TITLE BLOCK ============================== -->
            <Grid Grid.Row="2" Background="{DynamicResource FS.Surface}">
                <Grid.RowDefinitions><RowDefinition Height="2"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ui:DraftingLine IsActive="{Binding IsWorking}" LineBrush="{DynamicResource FS.RuleStrong}" StrokeBrush="{DynamicResource FS.Accent}"/>
                <Grid Grid.Row="1" MinHeight="64">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" MinWidth="170"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- NOTE: the status line, a link to the saved file, and a redline note for problems -->
                    <Border Padding="20,9,16,8">
                        <StackPanel VerticalAlignment="Center">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource FS.Text.Mono}" FontSize="12" Foreground="{DynamicResource FS.Ink2}" Text="{Binding ProgressLabel}"
                                           Margin="12,0,0,0" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}"/>
                                <TextBlock Style="{StaticResource FS.Text}" Text="{Binding StatusLine}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </DockPanel>
                            <Button Style="{StaticResource FS.Button.Quiet}" Content="Show in folder" Command="{Binding RevealSavedCommand}" FontSize="12" HorizontalAlignment="Left"
                                    Margin="0,2,0,0" Visibility="{Binding SavedPath, Converter={StaticResource Visible}}"/>
                            <DockPanel Margin="0,4,0,0" Visibility="{Binding Alert, Converter={StaticResource Visible}}">
                                <Button DockPanel.Dock="Right" Style="{StaticResource FS.Button.Glyph}" Width="22" Height="22" Command="{Binding DismissAlertCommand}" ToolTip="Dismiss">
                                    <Path Data="M0,0 L7,7 M7,0 L0,7" Stroke="{DynamicResource FS.Danger}" StrokeThickness="1.2"/>
                                </Button>
                                <Rectangle Width="2" Fill="{DynamicResource FS.Danger}" Margin="0,0,8,0"/>
                                <TextBlock Style="{StaticResource FS.Text.Small}" Text="{Binding Alert}" Foreground="{DynamicResource FS.Danger}" TextWrapping="Wrap"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Cell}">
                        <StackPanel VerticalAlignment="Center">
                            <ui:Caps Label="View" FontSize="9"/>
                            <TextBlock Style="{StaticResource FS.Text}" Text="{Binding ViewTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="220" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Cell}">
                        <StackPanel VerticalAlignment="Center">
                            <ui:Caps Label="Status" FontSize="9"/>
                            <Border x:Name="Stamp" Margin="0,3,0,0" BorderThickness="1" CornerRadius="1" Padding="6,1" HorizontalAlignment="Left">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource FS.RuleStrong}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StampTone}" Value="Review"><Setter Property="BorderBrush" Value="{DynamicResource FS.Warning}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding StampTone}" Value="Success"><Setter Property="BorderBrush" Value="{DynamicResource FS.Success}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding StampTone}" Value="Danger"><Setter Property="BorderBrush" Value="{DynamicResource FS.Danger}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding StampTone}" Value="Accent"><Setter Property="BorderBrush" Value="{DynamicResource FS.Accent}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ui:Caps Label="{Binding StampLabel}" FontSize="10" Foreground="{Binding BorderBrush, ElementName=Stamp}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource Cell}" Padding="16,0,20,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource FS.Button.Quiet}" Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,18,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsBusy, Converter={StaticResource Visible}}"/>
                            <Button Style="{StaticResource FS.Button.Primary}" Command="{Binding PrimaryCommand}" IsEnabled="{Binding CanPrimary}" MinWidth="176" ToolTip="Ctrl+Enter">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding PrimaryLabel}"/>
                                    <Path Data="M0,4 L11,4 M7.5,0.5 L11,4 L7.5,7.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"
                                          Margin="12,1,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
                <Rectangle Grid.Row="1" Height="1" VerticalAlignment="Top" Fill="{DynamicResource FS.Rule}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
