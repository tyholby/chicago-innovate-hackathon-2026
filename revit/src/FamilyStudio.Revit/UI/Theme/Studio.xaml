<!--
  Family Studio design system: type, components and states.

  Principles
  - A sheet, not a dashboard: a drawing area, a schedule column and a title block.
  - Line weight before colour: hairlines everywhere, a 2 px cut line for what is active.
  - One signal colour: cobalt means "act here". Redline (danger) is for errors only.
  - Numbers are sacred: dimensions are set in monospaced figures on dimension strings.
  - Pencil, then ink: AI-proposed values are drawn in construction blue until checked.

  Every colour is a DynamicResource token from Paper.xaml or Night.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:FamilyStudio.Revit.UI">

    <!-- ===== Type ============================================================================ -->
    <FontFamily x:Key="FS.Font.Sans">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FS.Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <!-- DIN 1451, the lettering of technical drawings, ships with Windows as Bahnschrift. -->
    <FontFamily x:Key="FS.Font.Label">Bahnschrift SemiCondensed, Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="FS.Font.Mono">Cascadia Mono, Consolas</FontFamily>

    <Style x:Key="FS.Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FS.Font.Sans}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource FS.Ink}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>
    <Style x:Key="FS.Text.Display" TargetType="TextBlock" BasedOn="{StaticResource FS.Text}">
        <Setter Property="FontFamily" Value="{StaticResource FS.Font.Display}"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="LineHeight" Value="36"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>
    <Style x:Key="FS.Text.Title" TargetType="TextBlock" BasedOn="{StaticResource FS.Text}">
        <Setter Property="FontFamily" Value="{StaticResource FS.Font.Display}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>
    <Style x:Key="FS.Text.Heading" TargetType="TextBlock" BasedOn="{StaticResource FS.Text}">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="FS.Text.Body" TargetType="TextBlock" BasedOn="{StaticResource FS.Text}">
        <Setter Property="Foreground" Value="{DynamicResource FS.Ink2}"/>
        <Setter Property="LineHeight" Value="19"/>
    </Style>
    <Style x:Key="FS.Text.Small" TargetType="TextBlock" BasedOn="{StaticResource FS.Text}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource FS.Ink3}"/>
        <Setter Property="LineHeight" Value="16"/>
    </Style>
    <Style x:Key="FS.Text.Mono" TargetType="TextBlock" BasedOn="{StaticResource FS.Text}">
        <Setter Property="FontFamily" Value="{StaticResource FS.Font.Mono}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>
    <!-- Tracked capitals: title block cells, sheet numbers, section labels. Never on buttons or body text. -->
    <Style TargetType="ui:Caps">
        <Setter Property="FontFamily" Value="{StaticResource FS.Font.Label}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource FS.Ink3}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <!-- ===== Buttons ========================================================================= -->
    <Style x:Key="FS.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" Stroke="{DynamicResource FS.Focus}" StrokeThickness="2" RadiusX="3" RadiusY="3" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FS.Button.Primary" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FS.Font.Sans}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource FS.OnAccent}"/>
        <Setter Property="Background" Value="{DynamicResource FS.Accent}"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FS.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource FS.AccentHover}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource FS.AccentPressed}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource FS.Rule}"/>
                            <Setter Property="Foreground" Value="{DynamicResource FS.Ink3}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FS.Button.Secondary" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FS.Font.Sans}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource FS.Ink}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FS.RuleStrong}"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FS.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="2" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource FS.Poche}"/>
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FS.Ink}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource FS.Selection}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource FS.Ink3}"/>
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FS.Rule}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FS.Button.Quiet" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FS.Font.Sans}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource FS.Accent}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FS.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <TextBlock x:Name="Label" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Label" Property="TextDecorations" Value="Underline"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource FS.Ink3}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Square, borderless buttons for the title bar and small tools. Content is usually a Path glyph. -->
    <Style x:Key="FS.Button.Glyph" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource FS.Ink2}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FS.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource FS.Poche}"/>
                            <Setter Property="Foreground" Value="{DynamicResource FS.Ink}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FS.Button.Close" TargetType="Button" BasedOn="{StaticResource FS.Button.Glyph}">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Frame" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource FS.Danger}"/>
                            <Setter Property="Foreground" Value="{DynamicResource FS.Surface}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Inputs ========================================================================== -->
    <!-- A field is a baseline, not a box: the way a note is written on a drawing. -->
    <Style x:Key="FS.Field" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource FS.Font.Sans}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource FS.Ink}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource FS.Accent}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource FS.Accent}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FS.RuleStrong}"/>
        <Setter Property="Padding" Value="0,5,0,6"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Base" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1" SnapsToDevicePixels="True">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Margin="2,5,0,6" Foreground="{DynamicResource FS.Ink3}" FontStyle="Italic"
                                           IsHitTestVisible="False" Visibility="Collapsed" TextWrapping="Wrap" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"/>
                            </Grid>
                        </Border>
                        <Rectangle x:Name="Cut" Height="2" VerticalAlignment="Bottom" Fill="{DynamicResource FS.Accent}" Visibility="Hidden" SnapsToDevicePixels="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Base" Property="BorderBrush" Value="{DynamicResource FS.Ink2}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Cut" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="Validation.HasError" Value="True"><Setter TargetName="Base" Property="BorderBrush" Value="{DynamicResource FS.Danger}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- General notes: a multi-line field on ruled paper. -->
    <Style x:Key="FS.Notes" TargetType="TextBox" BasedOn="{StaticResource FS.Field}">
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="TextBlock.LineHeight" Value="22"/>
        <Setter Property="TextBlock.LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Padding" Value="0,2,0,0"/>
        <Setter Property="MinHeight" Value="92"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Rectangle SnapsToDevicePixels="True">
                            <Rectangle.Fill>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,8,22" ViewportUnits="Absolute" Viewbox="0,0,8,22" ViewboxUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing Brush="{DynamicResource FS.Rule}">
                                            <GeometryDrawing.Geometry><RectangleGeometry Rect="0,21,8,1"/></GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"/>
                        <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Margin="2,2,0,0" Foreground="{DynamicResource FS.Ink3}" FontStyle="Italic"
                                   LineHeight="22" LineStackingStrategy="BlockLineHeight" IsHitTestVisible="False" Visibility="Collapsed" TextWrapping="Wrap"
                                   FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"/>
                        <Rectangle x:Name="Cut" Width="2" HorizontalAlignment="Left" Margin="-10,0,0,0" Fill="{DynamicResource FS.Accent}" Visibility="Hidden"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Cut" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      A dimension string: the value sits above a dimension line closed by 45 degree ticks.
      Lines stay construction blue until the dimension is checked (ui:Studio.Checked), then ink.
    -->
    <Style x:Key="FS.Dimension" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource FS.Font.Mono}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{DynamicResource FS.Ink}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource FS.Accent}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource FS.Accent}"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="Field" Background="{TemplateBinding Background}" CornerRadius="2" Margin="6,0">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Padding="0,3,0,1" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" HorizontalAlignment="Center" Margin="0,3,0,1" Foreground="{DynamicResource FS.Ink3}"
                                           FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" IsHitTestVisible="False" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" SnapsToDevicePixels="True">
                            <Rectangle x:Name="Line" Height="1" VerticalAlignment="Center" Fill="{DynamicResource FS.Construction}"/>
                            <Rectangle x:Name="ExtLeft" Width="1" HorizontalAlignment="Left" Fill="{DynamicResource FS.Construction}"/>
                            <Rectangle x:Name="ExtRight" Width="1" HorizontalAlignment="Right" Fill="{DynamicResource FS.Construction}"/>
                            <Path x:Name="TickLeft" Data="M0,8 L8,0" Width="8" Height="8" HorizontalAlignment="Left" Margin="-4,0,0,0" VerticalAlignment="Center"
                                  Stroke="{DynamicResource FS.Construction}" StrokeThickness="1.5"/>
                            <Path x:Name="TickRight" Data="M0,8 L8,0" Width="8" Height="8" HorizontalAlignment="Right" Margin="0,0,-4,0" VerticalAlignment="Center"
                                  Stroke="{DynamicResource FS.Construction}" StrokeThickness="1.5"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="ui:Studio.Checked" Value="True">
                            <Setter TargetName="Line" Property="Fill" Value="{DynamicResource FS.Ink}"/>
                            <Setter TargetName="ExtLeft" Property="Fill" Value="{DynamicResource FS.Ink}"/>
                            <Setter TargetName="ExtRight" Property="Fill" Value="{DynamicResource FS.Ink}"/>
                            <Setter TargetName="TickLeft" Property="Stroke" Value="{DynamicResource FS.Ink}"/>
                            <Setter TargetName="TickRight" Property="Stroke" Value="{DynamicResource FS.Ink}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="Background" Value="{DynamicResource FS.Poche}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Field" Property="Background" Value="{DynamicResource FS.Selection}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Choices ========================================================================= -->
    <!-- Sheet index: IF-001 BRIEF. The active sheet sits on a 2 px cut line. -->
    <Style x:Key="FS.SheetTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource FS.Ink3}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,26,0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FS.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <StackPanel VerticalAlignment="Center" Margin="0,2,0,0">
                            <ui:Caps Label="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource FS.Font.Mono}" FontWeight="Normal" FontSize="10" Foreground="{TemplateBinding Foreground}"/>
                            <ui:Caps Label="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontSize="12" Foreground="{TemplateBinding Foreground}" Margin="0,1,0,0"/>
                        </StackPanel>
                        <Rectangle x:Name="Cut" Height="2" VerticalAlignment="Bottom" Fill="{DynamicResource FS.Ink}" Visibility="Hidden"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource FS.Ink2}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource FS.Ink}"/>
                            <Setter TargetName="Cut" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented choice (units, detail, view). Place inside a FS.Segments border. -->
    <Style x:Key="FS.Segment" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource FS.Font.Label}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource FS.Ink3}"/>
        <Setter Property="Padding" Value="11,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FS.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Frame" Background="Transparent" CornerRadius="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource FS.Ink2}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource FS.Ink}"/>
                            <Setter Property="Foreground" Value="{DynamicResource FS.Surface}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FS.Segments" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource FS.RuleStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- A small square check. -->
    <Style x:Key="FS.Check" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource FS.Font.Sans}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource FS.Ink}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FS.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="15" Height="15" BorderThickness="1" BorderBrush="{DynamicResource FS.RuleStrong}" CornerRadius="1" VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Path x:Name="Mark" Data="M2.5,7.5 L6,11 L12.5,3.5" Stroke="{DynamicResource FS.OnAccent}" StrokeThickness="1.8" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource FS.Accent}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource FS.Accent}"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource FS.Ink}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The CHECKED stamp: NOT VERIFIED in ochre, dashed; VERIFIED in green, solid. -->
    <Style x:Key="FS.Stamp" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FS.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Rectangle x:Name="Dash" Stroke="{DynamicResource FS.Warning}" StrokeThickness="1.4" StrokeDashArray="3 2" RadiusX="2" RadiusY="2" SnapsToDevicePixels="True"/>
                        <Border x:Name="Solid" BorderBrush="{DynamicResource FS.Success}" BorderThickness="1.4" CornerRadius="2" Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" Margin="10,5">
                            <Path x:Name="Glyph" Data="M1,6 L4.5,9.5 L11,2" Stroke="{DynamicResource FS.Success}" StrokeThickness="1.8" Width="12" Height="11" Margin="0,0,7,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                            <ui:Caps x:Name="Text" Label="Dimensions not verified" Foreground="{DynamicResource FS.Warning}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dash" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Solid" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Text" Property="Label" Value="Dimensions verified"/>
                            <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource FS.Success}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A flat dropdown on a baseline, matching fields. -->
    <Style x:Key="FS.ComboItem" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource FS.Font.Sans}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource FS.Ink}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource FS.Selection}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FS.Combo" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource FS.Font.Sans}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource FS.Ink}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource FS.ComboItem}"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FS.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Base" Background="Transparent" BorderBrush="{DynamicResource FS.RuleStrong}" BorderThickness="0,0,0,1" SnapsToDevicePixels="True">
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Data="M0,0 L4.5,4.5 L9,0"
                                              Stroke="{DynamicResource FS.Ink2}" StrokeThickness="1.4"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Base" Property="BorderBrush" Value="{DynamicResource FS.Ink2}"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="0,5,22,6" IsHitTestVisible="False" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{DynamicResource FS.Raised}" BorderBrush="{DynamicResource FS.Rule}" BorderThickness="1" CornerRadius="3" Margin="0,4,12,12"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320">
                                <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.16" Color="{DynamicResource FS.ShadowColor}"/></Border.Effect>
                                <ScrollViewer Margin="0,4"><ItemsPresenter/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Surfaces ======================================================================== -->
    <Style x:Key="FS.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource FS.Raised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FS.Rule}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Effect">
            <Setter.Value><DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.22" Color="#000000"/></Setter.Value>
        </Setter>
    </Style>

    <!-- A figure: an image or drop zone framed by crop marks, as on a presentation board. -->
    <Style x:Key="FS.Plate" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Rectangle x:Name="Frame" Stroke="{DynamicResource FS.Construction}" StrokeThickness="1" StrokeDashArray="6 4" Margin="10" SnapsToDevicePixels="True"/>
                        <Path Data="M0,12 L0,0 L12,0" Stroke="{DynamicResource FS.Ink}" StrokeThickness="1.2" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Path Data="M0,0 L12,0 L12,12" Stroke="{DynamicResource FS.Ink}" StrokeThickness="1.2" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        <Path Data="M0,0 L0,12 L12,12" Stroke="{DynamicResource FS.Ink}" StrokeThickness="1.2" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                        <Path Data="M12,0 L12,12 L0,12" Stroke="{DynamicResource FS.Ink}" StrokeThickness="1.2" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        <ContentPresenter Margin="18"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ui:Studio.Checked" Value="True"><Setter TargetName="Frame" Property="Visibility" Value="Hidden"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Grid reference bubble: a circle with a number, the only round shape in the system. -->
    <Style x:Key="FS.Bubble" TargetType="ContentControl">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Ellipse Stroke="{DynamicResource FS.Ink}" StrokeThickness="1"/>
                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource FS.Font.Mono}" FontSize="10" Foreground="{DynamicResource FS.Ink}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thin scrollbars that stay out of the drawing. -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{DynamicResource FS.Rule}" CornerRadius="3" Margin="2,0"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="MinHeight" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource FS.Rule}" CornerRadius="3" Margin="0,2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource FS.Ink}"/>
        <Setter Property="Foreground" Value="{DynamicResource FS.Surface}"/>
        <Setter Property="FontFamily" Value="{StaticResource FS.Font.Sans}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="2" MaxWidth="320">
                        <ContentPresenter><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></ContentPresenter.Resources></ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
